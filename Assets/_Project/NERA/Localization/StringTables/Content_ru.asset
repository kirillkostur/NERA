  - m_Id: 1148182528
    m_Localized: "\u041E\u0421\u041A\u041E\u041B\u041E\u041A BLUE IO // \u0410\u041D\u0410\u041B\u0418\u0417
      \u0410\u041D\u041E\u041C\u0410\u041B\u0418\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 1148182529
    m_Localized: "\u0421\u043A\u043E\u043D\u0434\u0435\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u044D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B, \u0438\u0437\u0432\u043B\u0435\u0447\u0451\u043D\u043D\u044B\u0439
      \u0438\u0437 \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u0438 Blue IO. \u041B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u044B\u0439
      \u0430\u043D\u0430\u043B\u0438\u0437 \u0432\u044B\u044F\u0432\u0438\u043B \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0440\u0435\u0437\u043E\u043D\u0430\u043D\u0441 \u0441\u0440\u0435\u0434\u043D\u0435\u0439
      \u0441\u0438\u043B\u044B. \u041F\u043E\u0441\u043B\u0435 \u0438\u043D\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u0438
      \u0432 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u043E\u0435 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435
      \u043E\u0441\u043A\u043E\u043B\u043E\u043A \u0441\u043E\u0437\u0434\u0430\u0451\u0442
      \u043E\u0434\u0438\u043D \u0440\u0430\u0434\u0438\u0430\u043B\u044C\u043D\u044B\u0439
      \u0438\u043C\u043F\u0443\u043B\u044C\u0441, \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0430\u044E\u0449\u0438\u0439
      \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0435 \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0438
      IO."
    m_Metadata:
      m_Items: []
  - m_Id: 1148182530
    m_Localized: "\u0421\u0422\u0410\u041D\u0426\u0418\u042F NERA // \u0420\u0423\u041A\u041E\u0412\u041E\u0414\u0421\u0422\u0412\u041E
      \u041F\u041E \u042D\u041A\u0421\u041F\u041B\u0423\u0410\u0422\u0410\u0426\u0418\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 1148182531
    m_Localized: "\u0421\u0442\u0430\u043D\u0446\u0438\u044F \u0441\u043B\u0443\u0436\u0438\u0442
      \u0431\u0430\u0437\u043E\u0439 \u0434\u043B\u044F \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u0439.
      \u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0439\u0442\u0435
      \u0438 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0439\u0442\u0435
      \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B,
      \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0439\u0442\u0435 \u0440\u0430\u0437\u0432\u0435\u0434\u044B\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0434\u0440\u043E\u043D, \u0438\u0437\u0443\u0447\u0430\u0439\u0442\u0435
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0435 \u043B\u043E\u043A\u0430\u0446\u0438\u0438
      \u0438 \u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435
      \u043F\u0435\u0440\u0435\u0434 \u0432\u044B\u0445\u043E\u0434\u043E\u043C.
      \u041D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0435 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u044B
      \u0431\u0443\u0434\u0443\u0442 \u043F\u043E\u043F\u043E\u043B\u043D\u044F\u0442\u044C
      \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0443 \u043F\u043E \u043C\u0435\u0440\u0435
      \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1148182532
    m_Localized: "\u042F\u0414\u0420\u041E \u041F\u0410\u041C\u042F\u0422\u0418 NERA
      // \u041F\u0415\u0420\u0412\u0418\u0427\u041D\u042B\u0419 \u0410\u041D\u0410\u041B\u0418\u0417"
    m_Metadata:
      m_Items: []
  - m_Id: 1148182533
    m_Localized: "\u0412 \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u043E\u043C \u044F\u0434\u0440\u0435
      \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B
      \u0437\u0430\u043F\u0438\u0441\u0435\u0439 \u0441\u0442\u0430\u043D\u0446\u0438\u0438.
      \u0415\u0433\u043E \u044D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0440\u0438\u0441\u0443\u043D\u043E\u043A \u0441\u0442\u0430\u0431\u0438\u043B\u0435\u043D
      \u0438 \u0438\u043C\u0435\u0435\u0442 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435,
      \u0432 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0445
      \u0441\u0438\u0433\u043D\u0430\u0442\u0443\u0440 Blue IO. \u0410\u0440\u0445\u0438\u0432
      \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442, \u0447\u0442\u043E
      \u043F\u0435\u0440\u0435\u0434 \u044D\u0432\u0430\u043A\u0443\u0430\u0446\u0438\u0435\u0439
      \u0430\u0432\u0430\u043D\u043F\u043E\u0441\u0442 \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u043D\u043E
      \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B \u044D\u0442\u0438 \u0437\u0430\u043F\u0438\u0441\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1148182534
    m_Localized: "\u0414\u0420\u0415\u0412\u041D\u042F\u042F \u0417\u0410\u041F\u0418\u0421\u042C
      02 // \u041F\u0420\u041E\u0422\u041E\u041A\u041E\u041B \u0420\u0415\u0422\u0420\u0410\u041D\u0421\u041B\u042F\u0422\u041E\u0420\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 1148182535
    m_Localized: "\u0424\u0440\u0430\u0433\u043C\u0435\u043D\u0442 \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u043E\u0439
      \u0437\u0430\u043F\u0438\u0441\u0438 NERA \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
      \u0441\u0438\u0433\u043D\u0430\u043B\u044C\u043D\u0443\u044E \u0441\u0435\u0442\u044C,
      \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u0443\u044E
      \u0434\u043B\u044F \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F
      \u043E\u0442\u0434\u0430\u043B\u0451\u043D\u043D\u044B\u0445 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u0439.
      \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445
      \u043F\u0430\u043A\u0435\u0442\u043E\u0432 \u0442\u0430\u043A \u0438 \u043D\u0435
      \u0431\u044B\u043B\u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u044B.
      \u0412 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0438\u0445\u0441\u044F
      \u0441\u0438\u043C\u0432\u043E\u043B\u0430\u0445 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0442\u0441\u044F
      \u043F\u043E\u043D\u044F\u0442\u0438\u044F: \u0441\u0438\u0433\u043D\u0430\u043B,
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435,
      \u0432\u0440\u0430\u0442\u0430 \u0438 \u043F\u0430\u043C\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1148182536
    m_Localized: "\u0421\u0418\u0413\u041D\u0410\u041B\u042C\u041D\u042B\u0419 \u0420\u0415\u0422\u0420\u0410\u041D\u0421\u041B\u042F\u0422\u041E\u0420
      NERA // \u042D\u041A\u0421\u041F\u0415\u0414\u0418\u0426\u0418\u042F 02"
    m_Metadata:
      m_Items: []
  - m_Id: 1148182537
    m_Localized: "\u041D\u0430\u0439\u0434\u0435\u043D\u043D\u043E\u0435 \u044F\u0434\u0440\u043E
      \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u043B\u043E \u043F\u043B\u0430\u043D\u0435\u0442\u0430\u0440\u043D\u043E\u0439
      \u0441\u0438\u0433\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0442\u0438.
      \u0422\u0430\u0431\u043B\u0438\u0446\u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0446\u0438\u0438
      \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u043F\u0435\u0440\u0435\u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442
      \u0442\u0440\u0430\u0444\u0438\u043A \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u044C,
      \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u0443\u044E \u0438\u0441\u043A\u0430\u0436\u0435\u043D\u0438\u0435\u043C
      IO. \u0412 \u043C\u0430\u0441\u0441\u0438\u0432\u0435 \u0442\u0430\u043A\u0436\u0435
      \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u043D\u0435\u0430\u043A\u0442\u0438\u0432\u043D\u0430\u044F
      \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u043A\u0430\u043B\u0438\u0431\u0440\u043E\u0432\u043A\u0438, \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u0430\u044F
      \u0441 \u0430\u043D\u0442\u0435\u043D\u043D\u043E\u0439 \u0441\u0442\u0430\u043D\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
