  m_TableData:
  - m_Id: 1089462272
    m_Localized: "\u0414\u0440\u0435\u0432\u043D\u044F\u044F \u0437\u0430\u043F\u0438\u0441\u044C
      \u0440\u0435\u0442\u0440\u0430\u043D\u0441\u043B\u044F\u0442\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1118822400
    m_Localized: "\u041F\u043E\u0432\u0440\u0435\u0436\u0434\u0451\u043D\u043D\u0430\u044F
      \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u0430\u044F \u0442\u0430\u0431\u043B\u0438\u0447\u043A\u0430
      \u0438\u0437 \u0441\u0438\u0433\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0442\u0438.
      \u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0438\u0435\u0441\u044F
      \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B \u043C\u043E\u0433\u0443\u0442
      \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C, \u043F\u043E\u0447\u0435\u043C\u0443
      \u0440\u0435\u0442\u0440\u0430\u043D\u0441\u043B\u044F\u0442\u043E\u0440 \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u043B
      \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1118822401
    m_Localized: "\u042D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1118822402
    m_Localized: "\u041A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u043E\u0435 \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u043E\u0435
      \u043E\u0440\u0443\u0436\u0438\u0435, \u0441\u0442\u0440\u0435\u043B\u044F\u044E\u0449\u0435\u0435
      \u0441\u0444\u043E\u043A\u0443\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C\u0438
      \u044D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
      \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u0430\u043C\u0438 \u043F\u043E \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u043C
      \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u044F\u043C IO."
    m_Metadata:
      m_Items: []
  - m_Id: 1118822403
    m_Localized: "\u041E\u0441\u043A\u043E\u043B\u043E\u043A Blue IO"
    m_Metadata:
      m_Items: []
  - m_Id: 1118822404
    m_Localized: "\u0421\u043A\u043E\u043D\u0434\u0435\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
      \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u044F, \u043E\u0441\u0442\u0430\u0432\u0448\u0430\u044F\u0441\u044F
      \u043F\u043E\u0441\u043B\u0435 \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u0438
      Blue IO. \u0417\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u0443\u044E
      \u044F\u0447\u0435\u0439\u043A\u0443 \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1123016704
    m_Localized: "\u0418\u043D\u0442\u0435\u0433\u0440\u0430\u0442\u043E\u0440 IO"
    m_Metadata:
      m_Items: []
  - m_Id: 1123016705
    m_Localized: "\u0421\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u044B\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
      \u0434\u043B\u044F \u0438\u043D\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u0438
      \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u043D\u044B\u0445
      \u043A\u0430\u043C\u043D\u0435\u0439 \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0439
      IO."
    m_Metadata:
      m_Items: []
  - m_Id: 1123016706
    m_Localized: "\u042F\u0434\u0440\u043E \u043F\u0430\u043C\u044F\u0442\u0438 NERA"
    m_Metadata:
      m_Items: []
  - m_Id: 1123016707
    m_Localized: "\u041A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u043E\u0435 \u044F\u0434\u0440\u043E
      \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0434\u0430\u043D\u043D\u044B\u0445
      NERA, \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u043E\u0435 \u043D\u0430 \u0414\u0440\u0435\u0432\u043D\u0435\u043C
      \u0430\u0432\u0430\u043D\u043F\u043E\u0441\u0442\u0435. \u0413\u0435\u0440\u043C\u0435\u0442\u0438\u0447\u043D\u0430\u044F
      \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0430
      \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B \u0437\u0430\u043F\u0438\u0441\u0435\u0439
      \u0441\u0442\u0430\u043D\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1123016708
    m_Localized: "\u042F\u0434\u0440\u043E \u0441\u0438\u0433\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0440\u0435\u0442\u0440\u0430\u043D\u0441\u043B\u044F\u0442\u043E\u0440\u0430
      NERA"
    m_Metadata:
      m_Items: []
  - m_Id: 1123016709
    m_Localized: "\u041F\u043B\u043E\u0442\u043D\u043E\u0435 \u044F\u0434\u0440\u043E
      \u0440\u0435\u0442\u0440\u0430\u043D\u0441\u043B\u044F\u0442\u043E\u0440\u0430,
      \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u043E\u0435 \u0432 \u042D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u0438
      02. \u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0443\u044E\u0441\u044F
      \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0443 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0446\u0438\u0438
      \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438 \u0441\u0442\u0430\u043D\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1123016710
    m_Localized: "\u0421\u0435\u0440\u0432\u043E\u043F\u0440\u0438\u0432\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 1123016711
    m_Localized: "\u0418\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u0430\u044F \u0434\u0435\u0442\u0430\u043B\u044C
      \u0434\u043B\u044F \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
      \u0438 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u043E\u0432
      \u0441\u0442\u0430\u043D\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1135599616
    m_Localized: "\u042D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u044F 01
      \u2014 \u0414\u0440\u0435\u0432\u043D\u0438\u0439 \u0430\u0432\u0430\u043D\u043F\u043E\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1135599617
    m_Localized: "\u041D\u0435\u0434\u0430\u0432\u043D\u043E \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0439
      \u0434\u0440\u0435\u0432\u043D\u0438\u0439 \u043E\u0431\u044A\u0435\u043A\u0442.
      \u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u044B
      \u0438 \u0432\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C \u043D\u0430
      \u0441\u0442\u0430\u043D\u0446\u0438\u044E."
    m_Metadata:
      m_Items: []
