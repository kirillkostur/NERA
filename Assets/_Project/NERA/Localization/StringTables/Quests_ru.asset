    m_Metadata:
      m_Items: []
  - m_Id: 825221125
    m_Localized: "\u0414\u043E\u0431\u0443\u0434\u044C\u0442\u0435 \u043E\u0431\u0440\u0430\u0437\u0435\u0446
      Blue IO"
    m_Metadata:
      m_Items: []
  - m_Id: 825221126
    m_Localized: "\u0417\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u043E\u0441\u043A\u043E\u043B\u043E\u043A,
      \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0439\u0441\u044F \u043F\u043E\u0441\u043B\u0435
      \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 825221127
    m_Localized: "\u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C \u043D\u0430
      \u0441\u0442\u0430\u043D\u0446\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 825221128
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043E\u0431\u0440\u0430\u0437\u0435\u0446
      \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 825221129
    m_Localized: Запустите лабораторию.
    m_Metadata:
      m_Items: []
  - m_Id: 825221130
    m_Localized: Запустите лабораторию.
    m_Metadata:
      m_Items: []
  - m_Id: 8058507449327619
    m_Localized: Проанализируйте образец
    m_Metadata:
      m_Items: []
  - m_Id: 8058507449327620
    m_Localized: Проведите анализ Blue IO Shard в лаборатории.
    m_Metadata:
      m_Items: []
  - m_Id: 825221131
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0432\u044B\u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 825221132
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u044C\u0442\u0435 \u0440\u0430\u0437\u0432\u0435\u0434\u044B\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0434\u0440\u043E\u043D \u043D\u0430 \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u044E
      \u0438 \u0434\u043E\u0436\u0434\u0438\u0442\u0435\u0441\u044C \u0435\u0433\u043E
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u0441 \u0434\u0430\u043D\u043D\u044B\u043C\u0438
      \u043E \u043D\u043E\u0432\u043E\u0439 \u043B\u043E\u043A\u0430\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 825221133
    m_Localized: "\u0417\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0434\u0440\u043E\u043D
